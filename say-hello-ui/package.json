{
  "name": "say-hello-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=true --coverage",
    "install-vite-cov": "npm install @vitest/coverage-v8",
    "build:ilikeemail": "ng build --configuration ilikeemail",
    "gh-cli": "npm install -D angular-cli-ghpages",
    "build-github": "ng build -c github",
    "deploy-github": "ng build -c github && npx angular-cli-ghpages --dir=dist/say-hello-ui/browser --branch=gh-pages",
    "install-material": "ng add @angular/material",
    "shRoutingService": "ng g s services/shRouting.service",
    "shVoiceService": "ng g s services/shVoice.service",
    "vsEnums": "ng g i enums/voiceRecognition.enums",
    "execComponent": "ng g c components/execution-panel",
    "resultsComponent": "ng g c components/results-panel",
    "statusComponent": "ng g c components/results-panel/results-status",
    "ng-22-ug": "ng update @angular/core@22 @angular/cli@22",
    "ng-22m-ug": "ng update @angular/material@22",
    "shVoiceInterfaces": "ng g i interfaces/voiceRecognition.interfaces",
    "shDataService": "ng g s services/shData.service",
    "loadingComponent": "ng g c components/loader/loader"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "~22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "~22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@vitest/coverage-v8": "^4.0.16",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
